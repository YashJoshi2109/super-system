# Production Environment Variables
# Copy this to .env and fill in your actual values
# NEVER commit .env file to version control

# Server Configuration
NODE_ENV=production
PORT=3001

# Database (PostgreSQL with PostGIS)
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://username:password@db-host:5432/hotel_logistics

# CORS Origins (comma-separated list of allowed origins)
# NEVER use '*' in production - always specify exact domains
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Admin Security (REQUIRED - Use strong random PIN)
ADMIN_PIN=your-strong-random-admin-pin-minimum-16-characters

# Map API (Required for route calculation)
MAPTILER_KEY=your-maptiler-api-key-here

# Flight API (Optional - for flight terminal detection)
FLIGHT_API_KEY=your-flight-api-key-here

# SMS Notifications (Optional - Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Redis (Optional - Required for horizontal scaling)
# Format: redis://password@host:port or rediss:// for SSL
REDIS_URL=redis://password@redis-host:6379

# Weather API (Optional - OpenWeatherMap)
WEATHER_API_KEY=your-openweathermap-api-key

# Logging Level
LOG_LEVEL=info

# Session Secret (for future session management)
SESSION_SECRET=your-random-session-secret-minimum-32-characters